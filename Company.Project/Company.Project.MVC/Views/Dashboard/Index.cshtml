@model Company.Project.MVC.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header mb-4">
        <h1 class="display-6 text-primary mb-2">
            <i class="fas fa-tachometer-alt me-2"></i>Dashboard Overview
        </h1>
        <p class="text-muted">Welcome back! Here's what's happening with your business today.</p>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-uppercase mb-1 text-primary">Total Orders</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalOrders</div>
                            <div class="mt-2">
                                <span class="text-success text-sm font-weight-bold">
                                    <i class="fas fa-arrow-up"></i> @Model.OrderGrowth.ToString("F1")%
                                </span>
                                <span class="text-muted text-sm">vs last month</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-primary">
                                <i class="fas fa-shopping-cart text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-uppercase mb-1 text-success">Total Revenue</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.TotalRevenue.ToString("N2")</div>
                            <div class="mt-2">
                                <span class="text-success text-sm font-weight-bold">
                                    <i class="fas fa-arrow-up"></i> @Model.RevenueGrowth.ToString("F1")%
                                </span>
                                <span class="text-muted text-sm">vs last month</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-success">
                                <i class="fas fa-dollar-sign text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-uppercase mb-1 text-info">Total Users</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUsers</div>
                            <div class="mt-2">
                                <span class="text-success text-sm font-weight-bold">
                                    <i class="fas fa-arrow-up"></i> @Model.UserGrowth.ToString("F1")%
                                </span>
                                <span class="text-muted text-sm">vs last month</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-info">
                                <i class="fas fa-users text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-uppercase mb-1 text-warning">Total Products</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalProducts</div>
                            <div class="mt-2">
                                <span class="text-muted text-sm">Active products</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="icon-circle bg-warning">
                                <i class="fas fa-box text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
        <!-- Orders Chart -->
        <div class="col-xl-8 col-lg-7 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-line me-2"></i>Orders Over Time
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="ordersChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Order Status Chart -->
        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-pie me-2"></i>Order Status Distribution
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="orderStatusChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Chart and Recent Orders -->
    <div class="row mb-4">
        <!-- Users Chart -->
        <div class="col-xl-6 col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user-plus me-2"></i>New Users Over Time
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="usersChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="col-xl-6 col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-clock me-2"></i>Recent Orders
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td class="font-weight-bold">#@order.Id</td>
                                        <td>@order.UserName</td>
                                        <td>
                                            <span class="badge badge-@GetStatusBadgeClass(order.Status)">
                                                @order.Status
                                            </span>
                                        </td>
                                        <td class="font-weight-bold">$@order.TotalAmount.ToString("N2")</td>
                                        <td class="text-muted">@order.CreatedAt.ToString("MMM dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Users and Quick Actions -->
    <div class="row">
        <!-- Top Users -->
        <div class="col-xl-6 col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-trophy me-2"></i>Top Customers
                    </h6>
                </div>
                <div class="card-body">
                    <div id="topUsersContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-xl-6 col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <a asp-controller="Order" asp-action="Create" class="btn btn-outline-primary btn-block">
                                <i class="fas fa-plus me-2"></i>New Order
                            </a>
                        </div>
                        <div class="col-6 mb-3">
                            <a asp-controller="Product" asp-action="Create" class="btn btn-outline-success btn-block">
                                <i class="fas fa-box me-2"></i>Add Product
                            </a>
                        </div>
                        <div class="col-6 mb-3">
                            <a asp-controller="Account" asp-action="GetAll" class="btn btn-outline-info btn-block">
                                <i class="fas fa-users me-2"></i>Manage Users
                            </a>
                        </div>
                        <div class="col-6 mb-3">
                            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-warning btn-block">
                                <i class="fas fa-list me-2"></i>View Orders
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "warning",
            "processing" => "info",
            "shipped" => "primary",
            "delivered" => "success",
            "cancelled" => "danger",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart colors
        const colors = {
            primary: '#2a7c46',
            success: '#28a745',
            info: '#17a2b8',
            warning: '#ffc107',
            danger: '#dc3545',
            secondary: '#6c757d'
        };

        // Orders Chart
        const ordersCtx = document.getElementById('ordersChart').getContext('2d');
        fetch('/Dashboard/GetOrdersChartData')
            .then(response => response.json())
            .then(data => {
                new Chart(ordersCtx, {
                    type: 'line',
                    data: {
                        labels: data.map(item => item.month),
                        datasets: [{
                            label: 'Orders',
                            data: data.map(item => item.count),
                            borderColor: colors.primary,
                            backgroundColor: colors.primary + '20',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: '#f8f9fa'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            });

        // Order Status Chart
        const statusCtx = document.getElementById('orderStatusChart').getContext('2d');
        fetch('/Dashboard/GetOrdersStatusData')
            .then(response => response.json())
            .then(data => {
                const statusColors = [colors.primary, colors.success, colors.warning, colors.danger, colors.info];
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: data.map(item => item.status),
                        datasets: [{
                            data: data.map(item => item.count),
                            backgroundColor: statusColors,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true
                                }
                            }
                        }
                    }
                });
            });

        // Users Chart
        const usersCtx = document.getElementById('usersChart').getContext('2d');
        fetch('/Dashboard/GetUsersChartData')
            .then(response => response.json())
            .then(data => {
                new Chart(usersCtx, {
                    type: 'bar',
                    data: {
                        labels: data.map(item => item.month),
                        datasets: [{
                            label: 'New Users',
                            data: data.map(item => item.count),
                            backgroundColor: colors.info + '80',
                            borderColor: colors.info,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: '#f8f9fa'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            });

        // Load Top Users
        fetch('/Dashboard/GetTopUsers')
            .then(response => response.json())
            .then(data => {
                const container = document.getElementById('topUsersContainer');
                container.innerHTML = '';
                
                data.forEach((user, index) => {
                    const userDiv = document.createElement('div');
                    userDiv.className = 'd-flex align-items-center mb-3';
                    userDiv.innerHTML = `
                        <div class="flex-shrink-0">
                            <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center">
                                ${index + 1}
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="mb-0">${user.userName}</h6>
                            <small class="text-muted">${user.orderCount} orders • $${user.totalSpent.toFixed(2)}</small>
                        </div>
                    `;
                    container.appendChild(userDiv);
                });
            });
    </script>

    <style>
        .dashboard-container {
            padding: 0;
        }

        .stats-card {
            transition: transform 0.2s ease-in-out;
        }

        .stats-card:hover {
            transform: translateY(-2px);
        }

        .icon-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .avatar-sm {
            width: 40px;
            height: 40px;
            font-size: 0.875rem;
            font-weight: bold;
        }

        .badge {
            font-size: 0.75rem;
            padding: 0.375rem 0.75rem;
        }

        .badge-warning {
            background-color: #ffc107;
            color: #212529;
        }

        .badge-info {
            background-color: #17a2b8;
            color: #fff;
        }

        .badge-primary {
            background-color: #2a7c46;
            color: #fff;
        }

        .badge-success {
            background-color: #28a745;
            color: #fff;
        }

        .badge-danger {
            background-color: #dc3545;
            color: #fff;
        }

        .btn-block {
            width: 100%;
        }

        .card {
            border-radius: 12px;
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #5a5c69;
            font-size: 0.85rem;
        }

        .table td {
            border-top: 1px solid #e3e6f0;
            font-size: 0.85rem;
        }

        .text-xs {
            font-size: 0.75rem;
        }

        .text-sm {
            font-size: 0.875rem;
        }

        .font-weight-bold {
            font-weight: 700 !important;
        }

        .text-gray-800 {
            color: #5a5c69 !important;
        }

        .text-primary {
            color: #2a7c46 !important;
        }

        .text-success {
            color: #28a745 !important;
        }

        .text-info {
            color: #17a2b8 !important;
        }

        .text-warning {
            color: #ffc107 !important;
        }

        .text-danger {
            color: #dc3545 !important;
        }

        .text-muted {
            color: #858796 !important;
        }

        .bg-primary {
            background-color: #2a7c46 !important;
        }

        .bg-success {
            background-color: #28a745 !important;
        }

        .bg-info {
            background-color: #17a2b8 !important;
        }

        .bg-warning {
            background-color: #ffc107 !important;
        }

        .border-0 {
            border: 0 !important;
        }

        .shadow-sm {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
        }
    </style>
}
