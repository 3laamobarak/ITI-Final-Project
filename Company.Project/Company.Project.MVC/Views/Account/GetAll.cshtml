@model List<UserViewModel>


@{
    ViewBag.Title = "All Users";
    Layout = "_Layout";
}

<h2>All Users</h2>

<table class="table">
    <thead>
        <tr>
            <th>UserName</th>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>NID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Nid</td>
                <td>
                    <a asp-action="GetById" asp-route-id="@user.Id" class="btn btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>