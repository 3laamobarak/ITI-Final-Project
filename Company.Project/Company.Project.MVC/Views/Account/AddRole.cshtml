@model Company.Project.MVC.Models.RoleViewModel

@{
    ViewData["Title"] = "AddRole";
}

<h1>AddRole</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="SaveRole">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RoleName" class="control-label"></label>
                <input asp-for="RoleName" class="form-control" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
        @*current roles list from viewbag*@
        <h3>Current Roles</h3>
        <ul>
            @foreach (var role in ViewBag.Roles)
            {
                <li>@role</li>
                
                    <a asp-action="DeleteRole" asp-route-roleName="@role" class="btn btn-danger btn-sm">Delete</a>
                
            }
        </ul>
    </div>
</div>

<div>
    <a asp-controller="Home" asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
