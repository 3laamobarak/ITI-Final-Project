@model Company.Project.Domain.Models.ApplicationUser

@{
    ViewData["Title"] = "Profile";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <!-- Profile Sidebar -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body text-center p-4">
                    <!-- User Avatar -->
                    <div class="mb-3">
                        <div class="bg-success bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <i class="fas fa-user text-white" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    
                    <!-- User Info -->
                    <h4 class="fw-bold text-dark mb-1">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted mb-2">@Model.UserName</p>
                    <p class="text-muted small mb-3">@Model.Email</p>
                    
                    <!-- Status Badge -->
                    <span class="badge bg-success bg-gradient px-3 py-2">
                        <i class="fas fa-check-circle me-1"></i>Active
                    </span>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-light border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="fas fa-bolt me-2 text-success"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        <a asp-action="ChangePassword" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-home me-2"></i>Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Form -->
        <div class="col-md-8 col-lg-9">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold text-dark mb-1">
                                <i class="fas fa-user-edit me-2 text-success"></i>Edit Profile
                            </h4>
                            <p class="text-muted mb-0">Update your personal information</p>
                        </div>
                        <div class="text-end">
                            <small class="text-muted">Last updated: @DateTime.Now.ToString("MMM dd, yyyy")</small>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="SaveProfile" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <!-- Username -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label fw-semibold">
                                    <i class="fas fa-user me-2 text-success"></i>Username
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-user text-muted"></i>
                                    </span>
                                    <input asp-for="UserName" class="form-control border-start-0 ps-0" readonly />
                                </div>
                                <div class="form-text">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Username cannot be changed
                                    </small>
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope me-2 text-success"></i>Email Address
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-envelope text-muted"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="your@email.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- First Name -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    <i class="fas fa-id-card me-2 text-success"></i>First Name
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-id-card text-muted"></i>
                                    </span>
                                    <input asp-for="FirstName" class="form-control border-start-0 ps-0" placeholder="Enter first name" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    <i class="fas fa-id-card me-2 text-success"></i>Last Name
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fas fa-id-card text-muted"></i>
                                    </span>
                                    <input asp-for="LastName" class="form-control border-start-0 ps-0" placeholder="Enter last name" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- National ID -->
                        <div class="mb-4">
                            <label asp-for="NID" class="form-label fw-semibold">
                                <i class="fas fa-id-badge me-2 text-success"></i>National ID
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-id-badge text-muted"></i>
                                </span>
                                <input asp-for="NID" class="form-control border-start-0 ps-0" placeholder="Enter your national ID" />
                            </div>
                            <span asp-validation-for="NID" class="text-danger small"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-success fw-semibold px-4">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
        transition: all 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
    }
    
    .input-group-text {
        border-color: #dee2e6;
    }
    
    .form-control:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }
    
    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        transition: all 0.3s ease;
    }
    
    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
    }
    
    .btn-outline-success:hover,
    .btn-outline-secondary:hover {
        transform: translateY(-1px);
    }
    
    .badge {
        font-size: 0.8rem;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
