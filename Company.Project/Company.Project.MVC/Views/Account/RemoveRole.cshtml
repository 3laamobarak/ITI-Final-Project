@model Company.Project.MVC.Models.AssignRoleViewModel

@{
    ViewData["Title"] = "Remove Role";
}

<h1>Remove Role</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <h3>User: @Model.UserName</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in ViewBag.Roles)
                {
                    <tr>
                        <td>@role.Text</td>
                        <td>
                            <form asp-action="RemoveRole" method="post">
                                <input type="hidden" name="UserName" value="@Model.UserName" />
                                <input type="hidden" name="RoleName" value="@role.Value" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="AssignRole" class="btn btn-secondary">Back to Assign Role</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}