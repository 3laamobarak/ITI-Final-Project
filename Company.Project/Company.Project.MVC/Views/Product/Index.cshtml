@model IEnumerable<Company.Project.DTO.DTO.Product.ProductListDto>

@{
    ViewData["Title"] = "All Products";
}

<h3 class="mb-3">All Products</h3>

<div class="row g-3">
    @foreach (var p in Model)
    {
        <div class="col-md-3">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(p.ImageUrl))
                {
                    <img src="@p.ImageUrl" class="card-img-top" style="height:160px; object-fit:contain" />
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text text-muted small">@p.Description</p>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-success">@p.Price.ToString("C0")</strong>
                            <small class="text-muted">@p.BrandName</small>
                        </div>
                        <div class="mt-2">
                            <small class="text-secondary">Stock: @p.StockQuantity</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
