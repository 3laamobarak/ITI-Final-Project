<div id="chatWindow">
    @if (ViewBag.Messages != null)
    {
        foreach (var msg in ViewBag.Messages)
        {
            <div class="@(msg.SenderId == "admin" ? "sent" : "received")">
                <p>@msg.Content <span>@msg.Timestamp.ToString("g")</span></p>
            </div>
        }
    }
</div>
<input type="text" id="messageInput" placeholder="Type message..." />
<button id="sendButton">Send</button>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.js"></script>
<script>
    const userId = '@ViewBag.UserId';
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("http://localhost:5297/chathub", {
            withCredentials: true // Use Identity cookie for auth
        })
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", (senderUserId, message, timestamp) => {
        if (senderUserId === userId) {
            const msgDiv = document.createElement("div");
            msgDiv.classList.add("received");
            msgDiv.innerHTML = `<p>${message} <span>${new Date(timestamp).toLocaleString()}</span></p>`;
            document.getElementById("chatWindow").appendChild(msgDiv);
        }
    });

    connection.start().catch(err => console.error(err));

    document.getElementById("sendButton").addEventListener("click", () => {
        const message = document.getElementById("messageInput").value;
        if (message.trim()) {
            connection.invoke("SendMessageToUser", userId, message)
                .then(() => {
                    const msgDiv = document.createElement("div");
                    msgDiv.classList.add("sent");
                    msgDiv.innerHTML = `<p>${message} <span>${new Date().toLocaleString()}</span></p>`;
                    document.getElementById("chatWindow").appendChild(msgDiv);
                    document.getElementById("messageInput").value = "";
                })
                .catch(err => console.error(err));
        }
    });
</script>

<style>
    #chatWindow { height: 400px; overflow-y: scroll; }
    .sent { text-align: right; }
    .received { text-align: left; }
</style>