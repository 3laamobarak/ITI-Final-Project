@model Company.Project.Domain.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa fa-trash me-2 text-danger"></i>Delete Order #@Model.Id</h2>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2">
            <i class="fa fa-eye me-2"></i>View Details
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to Orders
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="fa fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">
                        <i class="fa fa-warning me-2"></i>Warning!
                    </h4>
                    <p>Are you sure you want to delete this order? This action cannot be undone.</p>
                    <hr>
                    <p class="mb-0">
                        <strong>This will permanently delete:</strong>
                        <ul class="mb-0 mt-2">
                            <li>The order record</li>
                            <li>All associated order items</li>
                            <li>Related payment and refund records</li>
                        </ul>
                    </p>
                </div>

                <form asp-action="Delete" method="post">
                    <input asp-for="Id" type="hidden" />
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa fa-trash me-2"></i>Yes, Delete Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa fa-info-circle me-2"></i>Order Information
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td><strong>Order ID:</strong></td>
                        <td>#@Model.Id</td>
                    </tr>
                    <tr>
                        <td><strong>Customer:</strong></td>
                        <td>
                            <div>
                                <strong>@(Model.User?.UserName ?? "Unknown")</strong>
                                <br>
                                <small class="text-muted">@(Model.User?.Email ?? "No email")</small>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Order Date:</strong></td>
                        <td>@Model.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <td><strong>Status:</strong></td>
                        <td>
                            @{
                                var statusClass = Model.Status switch
                                {
                                    Enums.OrderStatus.Pending => "warning",
                                    Enums.OrderStatus.Processing => "info",
                                    Enums.OrderStatus.Shipped => "primary",
                                    Enums.OrderStatus.Delivered => "success",
                                    Enums.OrderStatus.Cancelled => "danger",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@statusClass">@Model.Status</span>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Type:</strong></td>
                        <td><span class="badge bg-secondary">@Model.OrderType</span></td>
                    </tr>
                    <tr>
                        <td><strong>Total:</strong></td>
                        <td><strong>$@Model.Total.ToString("F2")</strong></td>
                    </tr>
                    <tr>
                        <td><strong>Items:</strong></td>
                        <td><span class="badge bg-light text-dark">@Model.OrderItems.Count items</span></td>
                    </tr>
                </table>

                <div class="mt-3">
                    <small class="text-muted">
                        <i class="fa fa-clock me-1"></i>
                        Created: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                    </small>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <br>
                        <small class="text-muted">
                            <i class="fa fa-edit me-1"></i>
                            Last Updated: @Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")
                        </small>
                    }
                </div>
            </div>
        </div>

        @if (Model.OrderItems.Any())
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fa fa-box me-2"></i>Order Items
                    </h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderItems.Take(5))
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong>@(item.Product?.Name ?? "Unknown Product")</strong>
                                <br>
                                <small class="text-muted">Qty: @item.Quantity</small>
                            </div>
                            @if (item.Product != null)
                            {
                                <span class="text-muted">$@((item.Product.Price * item.Quantity).ToString("F2"))</span>
                            }
                        </div>
                    }
                    @if (Model.OrderItems.Count > 5)
                    {
                        <div class="text-center">
                            <small class="text-muted">... and @(Model.OrderItems.Count - 5) more items</small>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
