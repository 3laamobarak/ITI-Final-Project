@model Company.Project.Domain.Models.Order

@{
    ViewData["Title"] = "Edit Order";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa fa-edit me-2 text-warning"></i>Edit Order #@Model.Id</h2>
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2">
            <i class="fa fa-eye me-2"></i>View Details
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fa fa-arrow-left me-2"></i>Back to Orders
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa fa-shopping-cart me-2"></i>Order Information
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CreatedAt" type="hidden" />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">Customer</label>
                                <select asp-for="UserId" class="form-select" asp-items="@(new SelectList(ViewBag.Users, "Id", "UserName"))">
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrderType" class="form-label">Order Type</label>
                                <select asp-for="OrderType" class="form-select" asp-items="@(new SelectList(ViewBag.OrderTypes))">
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="OrderType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-select" asp-items="@(new SelectList(ViewBag.OrderStatuses))">
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrderDate" class="form-label">Order Date</label>
                                <input asp-for="OrderDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label">Shipping Address</label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="Enter shipping address"></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Subtotal" class="form-label">Subtotal</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Subtotal" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Subtotal" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Tax" class="form-label">Tax</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Tax" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Tax" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="ShippingCost" class="form-label">Shipping Cost</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ShippingCost" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="ShippingCost" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label asp-for="Discount" class="form-label">Discount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Discount" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Discount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fa fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fa fa-save me-2"></i>Update Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa fa-info-circle me-2"></i>Order Summary
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> Editing order details may affect related payments and refunds.
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Total Preview</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="text" class="form-control" id="totalPreview" readonly value="@Model.Total.ToString("F2")" />
                    </div>
                    <small class="text-muted">Calculated automatically based on the values above</small>
                </div>

                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between">
                        <span>Subtotal:</span>
                        <span id="subtotalDisplay">$@Model.Subtotal.ToString("F2")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between">
                        <span>Tax:</span>
                        <span id="taxDisplay">$@Model.Tax.ToString("F2")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between">
                        <span>Shipping:</span>
                        <span id="shippingDisplay">$@Model.ShippingCost.ToString("F2")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between">
                        <span>Discount:</span>
                        <span id="discountDisplay" class="text-success">-$@Model.Discount.ToString("F2")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between border-top">
                        <strong>Total:</strong>
                        <strong id="totalDisplay">$@Model.Total.ToString("F2")</strong>
                    </div>
                </div>

                <div class="mt-3">
                    <small class="text-muted">
                        <i class="fa fa-clock me-1"></i>
                        Created: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                    </small>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <br>
                        <small class="text-muted">
                            <i class="fa fa-edit me-1"></i>
                            Last Updated: @Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Calculate total in real-time
        function calculateTotal() {
            const subtotal = parseFloat(document.getElementById('Subtotal').value) || 0;
            const tax = parseFloat(document.getElementById('Tax').value) || 0;
            const shipping = parseFloat(document.getElementById('ShippingCost').value) || 0;
            const discount = parseFloat(document.getElementById('Discount').value) || 0;
            
            const total = subtotal + tax + shipping - discount;
            
            document.getElementById('subtotalDisplay').textContent = '$' + subtotal.toFixed(2);
            document.getElementById('taxDisplay').textContent = '$' + tax.toFixed(2);
            document.getElementById('shippingDisplay').textContent = '$' + shipping.toFixed(2);
            document.getElementById('discountDisplay').textContent = '-$' + discount.toFixed(2);
            document.getElementById('totalDisplay').textContent = '$' + total.toFixed(2);
            document.getElementById('totalPreview').value = total.toFixed(2);
        }

        // Add event listeners to all numeric inputs
        document.addEventListener('DOMContentLoaded', function() {
            const inputs = ['Subtotal', 'Tax', 'ShippingCost', 'Discount'];
            inputs.forEach(id => {
                const element = document.getElementById(id);
                if (element) {
                    element.addEventListener('input', calculateTotal);
                }
            });
            
            // Format order date for datetime-local input
            const orderDate = new Date('@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")');
            const localDateTime = new Date(orderDate.getTime() - orderDate.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            document.getElementById('OrderDate').value = localDateTime;
        });
    </script>
}
