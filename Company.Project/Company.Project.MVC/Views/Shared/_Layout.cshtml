@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Company.Project.MVC</title>

    <!-- Bootstrap + FontAwesome -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            font-family: "Segoe UI", Roboto, sans-serif;
            background: #f8fafc;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #fff;
            border-right: 1px solid #e6e6e6;
            box-shadow: 2px 0 6px rgba(0,0,0,0.05);
            flex-shrink: 0;
            transition: all 0.3s;
            overflow-y: auto;
        }

            .sidebar h4 {
                padding: 1.2rem;
                margin: 0;
                font-size: 1.2rem;
                font-weight: bold;
                color: #2a7c46;
                border-bottom: 1px solid #e6e6e6;
            }

            .sidebar .nav-link {
                color: #333;
                padding: 10px 20px;
                border-radius: 8px;
                margin: 4px 10px;
                font-weight: 500;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

                .sidebar .nav-link:hover {
                    background: #e9f5ee;
                    color: #2a7c46;
                }

            .sidebar .submenu {
                padding-left: 1.5rem;
                display: none;
            }

                .sidebar .submenu.show {
                    display: block;
                }

                .sidebar .submenu .nav-link {
                    font-size: 0.9rem;
                    color: #666;
                    padding: 8px 20px;
                }

                    .sidebar .submenu .nav-link:hover {
                        background: #f0fdf4;
                        color: #2a7c46;
                    }

        /* Content */
        .content-wrapper {
            flex: 1;
            padding: 1.5rem;
        }

            .content-wrapper main {
                background: #fff;
                border-radius: 12px;
                padding: 1.5rem;
                box-shadow: 0 3px 8px rgba(0,0,0,0.05);
            }

        footer {
            margin-top: 1rem;
            text-align: center;
            color: #888;
        }

        /* Icons rotate when submenu open */
        .rotate {
            transform: rotate(-90deg);
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <h4>Admin Panel</h4>
        <ul class="nav flex-column">
            <!-- Dashboard -->
            <li class="nav-item">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                    <span><i class="fa fa-tachometer-alt me-2 text-success"></i> Dashboard</span>
                </a>
            </li>

            <!-- Products -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-box me-2 text-success"></i> Products</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Product" asp-action="GetAll">All Products</a></li>
                    <li><a class="nav-link" asp-controller="Product" asp-action="Create">Add Product</a></li>
                </ul>
            </li>

            <!-- Categories -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-list me-2 text-success"></i> Categories</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Category" asp-action="GetAll">All Categories</a></li>
                    <li><a class="nav-link" asp-controller="Category" asp-action="Create">Add Category</a></li>
                </ul>
            </li>

            <!-- Brands -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-tags me-2 text-success"></i> Brands</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Brand" asp-action="GetAll">All Brands</a></li>
                    <li><a class="nav-link" asp-controller="Brand" asp-action="Create">Add Brand</a></li>
                </ul>
            </li>

            <!-- Users -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-users me-2 text-success"></i> Users</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Account" asp-action="GetAll">All Users</a></li>
                    <li><a class="nav-link" asp-controller="Account" asp-action="AddRole">Add Roles </a></li>
                    <li><a class="nav-link" asp-controller="Account" asp-action="AssignRole">Assign & Remove Role To User</a></li>
                </ul>
            </li>

            <!-- Orders -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-shopping-cart me-2 text-success"></i> Orders</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Order" asp-action="Index">All Orders</a></li>
                    <li><a class="nav-link" asp-controller="Order" asp-action="Create">Create Order</a></li>
                </ul>
            </li>

            <!-- Account -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-user-circle me-2 text-success"></i> Account</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Account" asp-action="Profile">Profile</a></li>
                    <li><a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                </ul>
            </li>

            <!-- Settings -->
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-cog me-2 text-success"></i> Settings</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Settings" asp-action="General">General Settings</a></li>
                    <li><a class="nav-link" asp-controller="Settings" asp-action="Logs">System Logs</a></li>
                    <li><a class="nav-link" asp-controller="Settings" asp-action="Notifications">Notifications</a></li>
                </ul>
            </li>
            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-credit-card me-2 text-success"></i> Payments</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Payment" asp-action="Index">All Payments</a></li>
                </ul>
            </li>

            <li class="nav-item">
                <a href="javascript:void(0)" class="nav-link toggle-sub">
                    <span><i class="fa fa-undo me-2 text-success"></i> Refunds</span>
                    <i class="fa fa-angle-left"></i>
                </a>
                <ul class="submenu nav flex-column">
                    <li><a class="nav-link" asp-controller="Refund" asp-action="Index">All Refunds</a></li>
                </ul>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Account" asp-action="Logout">
                    <span><i class="fa fa-sign-out-alt me-2 text-danger"></i> Logout</span>
                </a>
            </li>
        </ul>
    </aside>
    @if (User.Identity.IsAuthenticated)
    {
        @User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value
        
    }
    else
    {
        <h4>guest</h4>
    }
    </center>
    
    <!-- Content -->
    <div class="content-wrapper">
        @* <main role="main" class="pb-3"> *@
            @RenderBody()
        @* </main> *@
        @* <footer class="border-top pt-3"> *@
        @*     &copy; 2025 - Company.Project.MVC *@
        @* </footer> *@
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle submenu
        document.querySelectorAll('.toggle-sub').forEach(link => {
            link.addEventListener('click', function () {
                let submenu = this.nextElementSibling;
                submenu.classList.toggle('show');
                this.querySelector('.fa-angle-left').classList.toggle('rotate');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
